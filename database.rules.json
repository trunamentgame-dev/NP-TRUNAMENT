        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid) || root.child('admins').child(auth.uid).exists() || auth.token.email === 'Mijanbabu2015@gmail.com' || auth.token.email === 'trunamentgame@gmail.com')"
      }
